# 数据库连接：SQLite 文件路径，相对于 prisma/ 目录
# 生产环境建议放到代码目录之外，如 DATABASE_URL="file:/var/lib/kit-lab/prod.db"
DATABASE_URL="file:./dev.db"

# Auth.js 会话加密密钥
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="请替换为随机生成的密钥"

# Seed 脚本创建的初始账号（可用环境变量覆盖以下默认值）
# 管理员账号（role=admin），可登录后访问 /admin 维护公共条目
ADMIN_EMAIL="admin@kitlab.local"
ADMIN_PASSWORD="Admin12345"
# 普通用户账号（role=user），用于体验收藏 / 私有工具
USER_EMAIL="user@kitlab.local"
USER_PASSWORD="User12345"

# 用户 HTML 工具落盘目录；生产环境应改到代码目录之外并纳入备份
HTML_TOOL_STORAGE_DIR="./data/user-html-tools"

# 强烈建议使用不共享主站登录 Cookie 的独立域名，以便 HTML 工具完整使用
# localStorage、跨域请求等浏览器能力。该域名仍反向代理到同一个 Next.js 服务。
# 本地示例：主站用 http://localhost:3000 时，可设为 http://127.0.0.1:3000。
HTML_TOOL_PUBLIC_ORIGIN=""

# HTML 工具跨域代理（/api/html-tools/proxy）默认拒绝访问环回/私网/云元数据地址，
# 防止被当成内网扫描器。确需让工具访问内网服务时设为 true。
HTML_TOOL_PROXY_ALLOW_PRIVATE=""

# 创建工具时自动生成图标的图像 API（留空则关闭）
ICON_GEN_API_BASE_URL="http://192.220.24.62:8000/v1"
ICON_GEN_API_KEY="your-api-key" # ⚠️ 请替换为你自己的密钥；不要提交真实 Key（仓库内历史版本中的 Key 已泄露，请轮换）
ICON_GEN_MODEL="grok-imagine-image"